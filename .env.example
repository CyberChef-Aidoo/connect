# Copy this file to .env and edit it. Never commit .env.
# Development on this PC only can keep HOST=127.0.0.1 and leave the HTTPS lines empty.
# A server other computers will open must use HTTPS. See the README.

HOST=127.0.0.1
PORT=3000

# Paths are relative to the project folder unless you use a full path.
STORAGE_DIR=data/storage
DATABASE_PATH=data/app.db

# 2 GiB per file, 50 GiB for the whole portal.
MAX_FILE_BYTES=2147483648
MAX_STORAGE_BYTES=53687091200

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

SESSION_TTL_HOURS=12

# Set to 1 to open the file list without a username or password.
# Anyone who can reach the site can then upload and download.
OPEN_ACCESS=

# LAN example (do not fill these in until you have created a certificate):
# HOST=0.0.0.0
# PORT=8443
# HTTPS_PFX_PATH=data/certs/portal.pfx
# HTTPS_PFX_PASSPHRASE=
# Or use a PEM key pair instead of a PFX:
# HTTPS_KEY_PATH=
# HTTPS_CERT_PATH=
